<!-- Un'unità con grafica propria: il Soldato semplice. È una COPIA intera della classe dell'hastatus (data\classes\RHastatus.sc.xml) con un altro id
     e, soprattutto, un'altra entity: units\RSimpleSoldier\RSimpleSoldier.ent.xml, che questo mod include insieme ai suoi .rle (gli sprite).
     Si copia intera (e non con parent="RHastatus") perché il gioco non eredita dal padre l'entità (il modello). -->
<class id="RSimpleSoldier" cpp_class="CVXUnit" parent="Melee" entity="Units/RSimpleSoldier/RSimpleSoldier.ent.xml">

	<properties race="RepublicanRome"/>
	<properties maxhealth="150"/>
	<properties damage="14" armor_slash="10" armor_pierce="10"/>
	<properties speed="60"/>
	<properties unit_specials="Deflection"/>

	<!-- Senza ritratto né pulsante propri: usa quelli dell'hastatus (strumenti/converti-immagine.js li crea, vedi l'esempio esempio-unita) -->
	<properties icon="gameres/icons/RHastatus.bmp"/>
	<properties display_name="Simple Soldier" display_name_plural="Simple Soldiers"/>
	<properties help="contents/units/RHastatus"/>
	<properties edittree_pos="Units/Roman/SimpleSoldier"/>
	<sounds command="data/sound entities/VoiceRHastatus.xml"/>

</class>
