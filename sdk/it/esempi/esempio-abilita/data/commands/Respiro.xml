<commands>

<!-- L'ordine (il pulsante). È un file nuovo: il gioco carica tutti gli .xml di data\commands.
     Il nome dell'ordine ("respiro") è lo stesso del "sig" del metodo che lo esegue (vedi patches\data\classes\Melee.sc.xml).
     È un ordine immediato, come "stand_position" in data\commands\UNIT.XML -->
<cmd name="respiro" priority="10"
	offset="1"
	button="Actions/Respiro.bmp"
	key="y"
	rollover="Second wind"
	description="The soldier recovers 60 health (costs stamina)"
	groupverifier=""
	groupdispatch=""
	voidgroupdispatch="1"
	coststamina="5"
	>
	<!-- Tutte le classi che discendono da Melee (i soldati in mischia di tutte le civiltà) ce l'hanno -->
	<src obj="Melee"/>
</cmd>

</commands>
