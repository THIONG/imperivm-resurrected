<patch>
  <!-- Un nuovo oggetto: si aggiunge all'elenco degli oggetti del gioco. L'immagine dell'icona è una del gioco (quella dei denti d'orso);
       per un'icona tua, mettila in gameres/icons/items/ dentro il mod e cambia il percorso. -->
  <add select="/items">
    <item id="Amuleto de ejemplo"
          image="gameres/icons/items/Bear Teeth.bmp"
          sound="data/sound entities/ItemUse.xml"
          level="0"
          name="Amuleto de ejemplo"
          description="Adds 10 to damage and 5 to armor"
          important="no">
      <bonus health="0" damage="10" armor_slash="5" armor_pierce="5" level="0" experience="0"/>
    </item>
  </add>
</patch>
