<commands>

<!-- The Roman barracks button to recruit the Veteran. It's a new file: the game loads every .xml in data\commands.
     It's a copy of "trainRHastatus" (data\commands\RBARRACKS.XML) with another class, another cost and its own images. -->
<cmd name="trainRVeteran" priority="3"
	button="actions/train RVeteran.bmp"
	queueicon="gameres/icons/RVeteran.bmp"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	transpicon="1"
	traincommand="yes"
	key="v"
	help="/contents/units/RHastatus"
	costgold="180"
	costfood="0"
	costpop="1"
	execdelay="9000"
	rollover="Equip Veteran"
	method="train"
	param="RVeteran"
	sclass="RVeteran">
	<src obj="RBarracks"/>
</cmd>

</commands>
