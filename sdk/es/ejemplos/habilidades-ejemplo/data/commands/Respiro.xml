<commands>

<!-- La orden (el botón). Es un archivo nuevo: el juego carga todos los .xml de data\commands.
     El nombre de la orden ("respiro") es el mismo que el "sig" del método que la ejecuta (ver patches\data\classes\Melee.sc.xml).
     Es una orden inmediata, como "stand_position" de data\commands\UNIT.XML -->
<cmd name="respiro" priority="10"
	offset="1"
	button="Actions/Respiro.bmp"
	key="y"
	rollover="Second wind"
	description="The soldier recovers 60 health (costs stamina)"
	groupverifier=""
	groupdispatch=""
	voidgroupdispatch="1"
	coststamina="5"
	>
	<!-- Todas las clases que cuelgan de Melee (los soldados cuerpo a cuerpo de todas las civilizaciones) la tienen -->
	<src obj="Melee"/>
</cmd>

</commands>
