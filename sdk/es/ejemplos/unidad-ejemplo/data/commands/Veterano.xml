<commands>

<!-- El botón del cuartel romano para reclutar al Veterano. Es un archivo nuevo: el juego carga todos los .xml de data\commands.
     Es una copia de "trainRHastatus" (data\commands\RBARRACKS.XML) con otra clase, otro coste y sus imágenes propias. -->
<cmd name="trainRVeteran" priority="3"
	button="actions/train RVeteran.bmp"
	queueicon="gameres/icons/RVeteran.bmp"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	transpicon="1"
	traincommand="yes"
	key="v"
	help="/contents/units/RHastatus"
	costgold="180"
	costfood="0"
	costpop="1"
	execdelay="9000"
	rollover="Equip Veteran"
	method="train"
	param="RVeteran"
	sclass="RVeteran">
	<src obj="RBarracks"/>
</cmd>

</commands>
