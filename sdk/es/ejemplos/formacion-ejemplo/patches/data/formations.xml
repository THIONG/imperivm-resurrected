<patch>
  <!-- Una formación nueva. Width/Height: tamaño de la rejilla de la primera línea. Bonus*: bonos mientras la tropa está parada (stand ground).
       Description no se muestra en el botón: el juego pone su propio texto.
       Cada <Class> dice dónde van las unidades de esa clase: FrontLine (delante), Wings (a los lados) o CentralBlock (en el centro) -->
  <add select="/Formations">
    <FormationClass Name="Wedge"
        Description="The warriors form a wedge with the cavalry at the point. Good for breaking an enemy line."
        Width="3"
        Height="1"
        BonusDamage="3"
        BonusArmor="1"
        OffsetFrontLineByY="40"
        OffsetWingsByX="30"
        OffsetWingsByY="0">

        <Class Name="Unit" Wings="1"/>
        <Class Name="Horse" FrontLine="1"/>
        <Class Name="BaseMage" CentralBlock="1"/>
        <Class Name="Peasant" CentralBlock="1"/>
    </FormationClass>
  </add>
</patch>
