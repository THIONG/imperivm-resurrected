#include <windows.h>
#include <winver.h>
#include "core/version_info.h"

1 24 "installer.manifest"
1 ICON "installer.ico"

100 DIALOGEX 0, 0, 196, 68
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Imperivm Resurrected"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
	ICON 1, -1, 10, 9, 21, 20
	LTEXT "", 201, 40, 9, 148, 10
	COMBOBOX 202, 40, 22, 148, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	DEFPUSHBUTTON "OK", IDOK, 84, 50, 50, 13
	PUSHBUTTON "Cancel", IDCANCEL, 138, 50, 50, 13
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION IMPERIVM_VERSION_NUMBER
PRODUCTVERSION IMPERIVM_VERSION_NUMBER
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "Imperivm Resurrected"
			VALUE "FileDescription", "Imperivm Resurrected Setup"
			VALUE "FileVersion", IMPERIVM_VERSION_TEXT
			VALUE "InternalName", "imperivm-resurrected-setup"
			VALUE "LegalCopyright", "Copyright (C) 2026 THIONG. GPL-3.0-or-later."
			VALUE "OriginalFilename", "imperivm-resurrected-setup.exe"
			VALUE "ProductName", "Imperivm Resurrected"
			VALUE "ProductVersion", IMPERIVM_VERSION_TEXT
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
